pipeline {
    agent { label "${env.JENKINS_AGENT}" }
	
	environment {
		CMAKE_BUILD_TYPE='Release'
		MAKE_THREADS='4'
	}

    stages {
        stage('Build') {
            steps {			
				sh 'rm -rf install'
				sh 'rm -rf build'
				sh 'mkdir build'
				sh "echo ${env.WORKSPACE}"
				sh "cd build && cmake -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} -DCMAKE_INSTALL_PREFIX=${env.WORKSPACE}/install/mpo -DCMAKE_SYSTEM_NAME=$CMAKE_SYSTEM_NAME -DCMAKE_C_COMPILER=$CMAKE_C_COMPILER -DCMAKE_CXX_COMPILER=$CMAKE_CXX_COMPILER -DCMAKE_AR=$CMAKE_AR -DCMAKE_RANLIB=$CMAKE_RANLIB \${CMAKE_OSX_SYSROOT:+-DCMAKE_OSX_SYSROOT=\$CMAKE_OSX_SYSROOT} \${CMAKE_OSX_ARCHITECTURES:+-DCMAKE_OSX_ARCHITECTURES=\"\$CMAKE_OSX_ARCHITECTURES\"} \${CMAKE_OSX_DEPLOYMENT_TARGET:+-DCMAKE_OSX_DEPLOYMENT_TARGET=\$CMAKE_OSX_DEPLOYMENT_TARGET} .."
				sh 'cd build && make -j ${MAKE_THREADS}'
            }
        }
        stage('Test') {
            when {
                environment name: 'JENKINS_AGENT_PLATFORM', value: 'linux'
            }
            steps {			
				sh 'cd build/tests && ./test_mpolib'
            }
        }
        stage('Package') {
            steps {			
				sh 'cd build && make install'
				sh 'cd install && tar cvfz ../ci/mpolib2Install.tar.gz mpo'
                archiveArtifacts artifacts: 'ci/mpolib2Install.tar.gz', onlyIfSuccessful: true, fingerprint: true				
            }
        }		
    }
}

