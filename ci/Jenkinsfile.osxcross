pipeline {
    agent { label 'cmake-osxcross' }
	
	environment {
		CMAKE_BUILD_TYPE='Release'
		MAKE_THREADS='4'
	}

    stages {
        stage('Build') {
            steps {			
				sh 'rm -rf install'
				sh 'rm -rf build'
				sh 'mkdir build'
				sh "echo ${env.WORKSPACE}"
				sh "cd build && cmake -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} -DCMAKE_INSTALL_PREFIX=${env.WORKSPACE}/install/mpo -DCMAKE_SYSTEM_NAME=Darwin -DCMAKE_C_COMPILER=o64-clang -DCMAKE_CXX_COMPILER=o64-clang++ .."
				sh 'cd build && make -j ${MAKE_THREADS}'
            }
        }
        stage('Package') {
            steps {			
				sh 'cd build && make install'
				sh 'cd install && tar cvfz ../ci/mpolib2Install.tar.gz mpo'
                archiveArtifacts artifacts: 'ci/mpolib2Install.tar.gz', onlyIfSuccessful: true, fingerprint: true				
            }
        }		
    }
}

